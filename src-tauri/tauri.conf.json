{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCP Deck",
  "version": "0.1.0",
  "identifier": "com.mcpdeck.desktop",
  "build": {"beforeDevCommand":"npm run dev","devUrl":"http://127.0.0.1:1420","beforeBuildCommand":"npm run build","frontendDist":"../dist"},
  "app": {
    "windows": [{"label":"main","title":"MCP Deck","width":1360,"height":900,"minWidth":960,"minHeight":640,"backgroundColor":"#F5F6F1"}],
    "security": {"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {"active":true,"targets":["app"],"category":"DeveloperTool","shortDescription":"统一管理 AI Agent 的 MCP 配置","icon":["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"],"macOS":{"minimumSystemVersion":"12.0"}}
}
